# CITY WORKSHOP Backend Environment Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit actual .env file to Git

# Application
NODE_ENV=development
DEBUG=app:*
PORT=3001
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password_here
DB_DATABASE=city_workshop
DB_SSL=false

# Cache (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Secrets (Generate strong random strings in production)
JWT_SECRET=your_jwt_secret_key_here_min_32_chars
JWT_EXPIRY=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here_min_32_chars
JWT_REFRESH_EXPIRY=7d

# File Storage
STORAGE_TYPE=local
# For AWS S3:
# AWS_REGION=ap-south-1
# AWS_S3_BUCKET=your-bucket-name
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_S3_FOLDER_PREFIX=development/

# For MinIO:
# MINIO_ENDPOINT=localhost
# MINIO_PORT=9000
# MINIO_USE_SSL=false
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=cityworkhop

# Local file upload directory (if using STORAGE_TYPE=local)
LOCAL_UPLOAD_DIR=./uploads

# External Services (to be configured in later phases)
# PAYMENT_GATEWAY=razorpay
# RAZORPAY_KEY_ID=key_xxx
# RAZORPAY_KEY_SECRET=secret_xxx

# SMS Provider
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=AC_xxx
# TWILIO_AUTH_TOKEN=token_xxx

# Email Provider
# EMAIL_PROVIDER=sendgrid
# SENDGRID_API_KEY=key_xxx

# WhatsApp
# WHATSAPP_BUSINESS_PHONE_ID=123456789
# WHATSAPP_ACCESS_TOKEN=token_xxx

# Maps
# GOOGLE_MAPS_API_KEY=key_xxx
# MAPBOX_API_TOKEN=token_xxx

# Analytics & Monitoring
# SENTRY_DSN=
# ANALYTICS_TRACKING_ID=
